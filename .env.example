# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. .env.local is gitignored.
#   cp .env.example .env.local          (Git Bash)
#   Copy-Item .env.example .env.local   (PowerShell)
#
# WARNING: anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle
# and is publicly readable. Never add that prefix to a secret.
# ---------------------------------------------------------------------------

# ---- Supabase (client-safe) ----
# Project Settings -> Data API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The anon/publishable key. Safe to expose ONLY if Row Level Security is on.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---- Supabase (SERVER ONLY -- never expose) ----
# Bypasses Row Level Security entirely. Server components / route handlers only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Web Push / VAPID ----
# Generate a keypair with:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
# SERVER ONLY -- signs push payloads.
VAPID_PRIVATE_KEY=your-vapid-private-key
# Contact URI for push services. Must be a mailto: or https: URL.
VAPID_SUBJECT=mailto:you@example.com

# ---- 자동 알림 스케줄러 (SERVER ONLY -- 절대 노출 금지) ----
# POST /api/cron/auto-nudge 를 호출할 때 쓰는 공유 비밀입니다.
# Supabase pg_cron -> pg_net 이 아래 헤더로 이 라우트를 5분마다 두드립니다.
#   Authorization: Bearer <CRON_SECRET>
# 만드는 법:  openssl rand -base64 48
#
#   * 이 파일(.env.example)은 git 에 올라갑니다. 진짜 값을 여기 적지 마세요.
#     진짜 값은 .env.local(gitignored)과 Vercel 환경변수, 그리고 Supabase Vault
#     (vault.create_secret 로 저장한 값) 세 곳에 똑같이 넣습니다.
#   * NEXT_PUBLIC_ 을 붙이면 브라우저 번들에 그대로 박혀서 누구나 남의 알림을
#     강제로 울릴 수 있습니다. 절대 붙이지 마세요.
#   * 값이 비어 있으면 라우트는 열리는 게 아니라 전부 거절합니다(fail closed).
#   * 쿼리스트링(?secret=...)으로는 받지 않습니다. 로그와 리퍼러에 남기 때문이에요.
CRON_SECRET=your-cron-shared-secret
