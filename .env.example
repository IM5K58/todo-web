# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. .env.local is gitignored.
#   cp .env.example .env.local          (Git Bash)
#   Copy-Item .env.example .env.local   (PowerShell)
#
# WARNING: anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle
# and is publicly readable. Never add that prefix to a secret.
# ---------------------------------------------------------------------------

# ---- Supabase (client-safe) ----
# Project Settings -> Data API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The anon/publishable key. Safe to expose ONLY if Row Level Security is on.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---- Supabase (SERVER ONLY -- never expose) ----
# Bypasses Row Level Security entirely. Server components / route handlers only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Web Push / VAPID ----
# Generate a keypair with:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
# SERVER ONLY -- signs push payloads.
VAPID_PRIVATE_KEY=your-vapid-private-key
# Contact URI for push services. Must be a mailto: or https: URL.
VAPID_SUBJECT=mailto:you@example.com
